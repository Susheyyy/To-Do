{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todo-desktop",
  "version": "0.1.0",
  "identifier": "com.amy.todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "To-Do",
        "width": 1100,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500,
        "visible": false
      },
      {
        "label": "quick-capture",
        "title": "Quick Capture",
        "width": 380,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "url": "index.html?window=quick-capture"
      },
      {
        "label": "floating-bar",
        "title": "Quick Add",
        "width": 640,
        "height": 68,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "shadow": true,
        "url": "index.html?window=floating-bar"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
